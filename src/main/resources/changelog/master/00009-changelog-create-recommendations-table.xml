<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="create-recommendations-table" author="Roman">
        <createTable tableName="recommendations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="recommendations"
                                 baseColumnNames="user_id"
                                 constraintName="fk_recommendations_user"
                                 referencedTableName="users"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Many-to-Many relationship table -->
        <createTable tableName="recommendation_exercises">
            <column name="recommendation_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="exercise_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="recommendation_exercises"
                       columnNames="recommendation_id,exercise_id"
                       constraintName="pk_recommendation_exercises"/>

        <addForeignKeyConstraint baseTableName="recommendation_exercises"
                                 baseColumnNames="recommendation_id"
                                 constraintName="fk_recommendation_exercises_recommendation"
                                 referencedTableName="recommendations"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="recommendation_exercises"
                                 baseColumnNames="exercise_id"
                                 constraintName="fk_recommendation_exercises_exercise"
                                 referencedTableName="exercises"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>

